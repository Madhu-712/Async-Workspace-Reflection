rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Ensure the authenticated user matches the owner of the user-specific directories
    match /users/{userId} {
      
      // Strict isolation for personal profiles
      match /profile {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Strict isolation for individual reflection journal entries
      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared team workspace collections
    match /standups/{standupId} {
      allow read, write: if request.auth != null;
    }

    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    match /signals/{signalId} {
      allow read, write: if request.auth != null;
    }
  }
}
